---
import '../styles/fonts.css';
import '../styles/site.css';
import Nav from '../components/Nav.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  page: 'home' | 'posts' | 'post' | 'projects' | 'project' | 'journey' | 'about' | '404';
  footer?: boolean;
  /** Social preview image path, eg /og/<slug>.png */
  image?: string;
}
const { title, description = 'Calvin Lobo on software architecture, engineering efficiency and building products.', page, footer = true, image = '/og/site.png' } = Astro.props;
const ogImage = new URL(image, Astro.site);
const canonical = new URL(Astro.url.pathname, Astro.site);
import Footer from '../components/Footer.astro';
import { xHandle } from '../data/social';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script is:inline>
  // Theme before first paint: ?time= override, then the saved choice, then the local hour.
  (function () {
    var saved = null;
    try { saved = localStorage.getItem('time'); } catch (e) {}
    var forced = new URLSearchParams(location.search).get('time');
    var h = new Date().getHours();
    var t = forced || saved || (h >= 7 && h < 19 ? 'day' : 'night');
    document.documentElement.dataset.time = t === 'day' ? 'day' : 'night';
  })();
</script>
<title>{title}</title>
<meta name="description" content={description}>
{page === '404'
  ? <meta name="robots" content="noindex">
  : <link rel="canonical" href={canonical}>}
<meta property="og:site_name" content="lobocv">
<meta property="og:type" content={page === 'post' ? 'article' : 'website'}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content={xHandle}>
<meta name="twitter:creator" content={xHandle}>
<link rel="alternate" type="application/rss+xml" title="lobocv" href="/index.xml">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6GL7S6YEB3"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-6GL7S6YEB3');
</script>
<slot name="head" />
</head>
<body data-page={page}>
{page !== 'home' && <div class="side-foliage page-side" id="page-side" aria-hidden="true"></div>}
<Nav page={page}><slot name="nav" /></Nav>
<slot />
{footer && <Footer />}
<ThemeToggle />
{page !== 'home' && (
  <script>
    import { sideFoliage } from '../scripts/art/landscape.js';
    // Starts below the horizon band and is redrawn when the page height changes (eg images loading)
    const el = document.getElementById('page-side')!;
    let drawn = 0;
    const draw = () => {
      const top = document.getElementById('horizon')?.offsetHeight ?? 0;
      const h = document.body.scrollHeight - top;
      if (Math.abs(h - drawn) < 40) return;
      drawn = h;
      el.style.top = `${top}px`;
      sideFoliage(el, h);
    };
    new ResizeObserver(draw).observe(document.body);
  </script>
)}
</body>
</html>
