---
// Circular arrow button in a figure's top-right corner. Figures that animate play once when scrolled
// into view; this plays them again. Listen for clicks on `.fig-replay` in the figure's script.
interface Props { label?: string; title?: string }
const { label = 'Replay', title } = Astro.props;
---
<button type="button" class="fig-replay" aria-label={label} title={title}>
  <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.34-5.66" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>
