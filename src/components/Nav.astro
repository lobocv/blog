---
import { getProjects } from '../lib/projects';
import { TIMELINE } from '../data/timeline';

interface Props { page: string }
const { page } = Astro.props;
// Projects stays out of the nav until one is published (drafts count in dev)
const hasProjects = (await getProjects()).length > 0;
const links = [
  { href: '/posts/', label: 'Writing', on: page === 'posts' || page === 'post' },
  ...(hasProjects ? [{ href: '/projects/', label: 'Projects', on: page === 'projects' || page === 'project' }] : []),
  // Journey stays out of the nav in production until Calvin publishes it
  ...(!(import.meta.env.PROD && TIMELINE.draft) ? [{ href: '/journey/', label: 'Journey', on: page === 'journey' }] : []),
];
---
<nav class="nav">
  <a class="brand" href="/"><svg viewBox="-30 -40 60 60" aria-hidden="true"><path fill={page === 'home' ? '#eef1f7' : undefined} d="M-18,10 L-20,-6 L-17,-30 L-8,-14 L0,-16 L8,-14 L17,-30 L20,-6 L18,10 L0,18 Z"/></svg>lobocv</a>
  <div class="links">{links.map(l => <a href={l.href} aria-current={l.on ? 'page' : undefined}>{l.label}</a>)}</div>
  <slot />
</nav>
