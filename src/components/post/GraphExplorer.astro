---
// What a topic graph links to: topics form trees, and each topic
// links to the resources behind it, from any source. Links run many-to-many.
// Tap a topic to see its resources, or a resource to see its topics. Used on the communicating_effectively_with_agents post.
// The lines are drawn by the script from the rendered rows; without JS it shows the two lists.
interface Topic { id: string; root?: boolean; parent?: string; anchors: string[] }
interface Resource { id: string; source: string; dir?: string; name: string }

const topics: Topic[] = [
  { id: 'equity', root: true, anchors: [] },
  { id: 'vesting-schedules', parent: 'equity', anchors: ['grant', 'timeline', 'pg-grants', 'notion-policy'] },
  { id: 'share-transfers', parent: 'equity', anchors: ['transfer', 'grant', 'pg-transfers'] },
  { id: 'billing', root: true, anchors: [] },
  { id: 'invoices', parent: 'billing', anchors: ['invoice', 'pg-invoices', 'transfer'] },
];
const resources: Resource[] = [
  { id: 'grant', source: 'repo', dir: 'domain/', name: 'grant.go' },
  { id: 'transfer', source: 'repo', dir: 'app/', name: 'transfer_service.go' },
  { id: 'timeline', source: 'repo', dir: 'web/', name: 'VestingTimeline.tsx' },
  { id: 'invoice', source: 'repo', dir: 'billing/', name: 'invoice.go' },
  { id: 'pg-grants', source: 'postgres', name: 'grants' },
  { id: 'pg-transfers', source: 'postgres', name: 'transfers' },
  { id: 'pg-invoices', source: 'postgres', name: 'invoices' },
  { id: 'notion-policy', source: 'notion', name: 'Vesting policy' },
];
const sources = [...new Set(resources.map(r => r.source))];
// Each source's heading: what its resources are, with an icon (Notion and PostgreSQL logos from Simple Icons, CC0)
const sourceInfo: Record<string, { kind: string; icon: string; stroke?: boolean }> = {
