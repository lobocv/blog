  notion: { kind: 'pages', icon: 'M4.459 4.208c.746.606 1.026.56 2.428.466l13.215-.793c.28 0 .047-.28-.046-.326L17.86 1.968c-.42-.326-.981-.7-2.055-.607L3.01 2.295c-.466.046-.56.28-.374.466zm.793 3.08v13.904c0 .747.373 1.027 1.214.98l14.523-.84c.841-.046.935-.56.935-1.167V6.354c0-.606-.233-.933-.748-.887l-15.177.887c-.56.047-.747.327-.747.933zm14.337.745c.093.42 0 .84-.42.888l-.7.14v10.264c-.608.327-1.168.514-1.635.514-.748 0-.935-.234-1.495-.933l-4.577-7.186v6.952L12.21 19s0 .84-1.168.84l-3.222.186c-.093-.186 0-.653.327-.746l.84-.233V9.854L7.822 9.76c-.094-.42.14-1.026.793-1.073l3.456-.233 4.764 7.279v-6.44l-1.215-.139c-.093-.514.28-.887.747-.933zM1.936 1.035l13.31-.98c1.634-.14 2.055-.047 3.082.7l4.249 2.986c.7.513.934.653.934 1.213v16.378c0 1.026-.373 1.634-1.68 1.726l-15.458.934c-.98.047-1.448-.093-1.962-.747l-3.129-4.06c-.56-.747-.793-1.306-.793-1.96V2.667c0-.839.374-1.54 1.447-1.632z' },
};
const data = JSON.stringify({ topics, resources });
---
<figure class="gx" data-graph={data}>
  <div class="gx-grid">
    <svg class="gx-lines" aria-hidden="true"></svg>
    <div class="gx-col gx-topics">
      <div class="gx-head">Topics</div>
      <ul>
        {topics.map(t => (
          <li><button type="button" class:list={['gx-node', 'gx-topic', { root: t.root }]} data-id={t.id}>{!t.root && <span class="gx-branch">└</span>}{t.id}</button></li>
        ))}
      </ul>
    </div>
    <div class="gx-col gx-res">
      {sources.map(s => (
        <>
          <div class="gx-head">
            <svg class:list={['gx-icon', { stroke: sourceInfo[s].stroke }]} viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d={sourceInfo[s].icon} /></svg>
            {s}<span class="gx-kind">{sourceInfo[s].kind}</span>
          </div>
          <ul>
            {resources.filter(r => r.source === s).map(r => (
              <li><button type="button" class="gx-node gx-resource" data-id={r.id}>{r.dir && <span class="gx-dir">{r.dir}</span>}{r.name}</button></li>
            ))}
          </ul>
        </>
      ))}
    </div>
  </div>
</figure>

<script>
  type Topic = { id: string; root?: boolean; parent?: string; anchors: string[] };
  const NS = 'http://www.w3.org/2000/svg';

  function setup(fig: HTMLElement) {
    const { topics } = JSON.parse(fig.dataset.graph!) as { topics: Topic[] };
    const grid = fig.querySelector('.gx-grid') as HTMLElement;
    const svg = fig.querySelector('.gx-lines') as SVGSVGElement;
    const node = (id: string) => fig.querySelector(`.gx-node[data-id="${id}"]`) as HTMLElement;
    const children = (id: string) => topics.filter(t => t.parent === id).map(t => t.id);
    let active = 'share-transfers';

    const draw = () => {
      const g = grid.getBoundingClientRect();
      svg.setAttribute('viewBox', `0 0 ${g.width} ${g.height}`);
      svg.replaceChildren();
      const box = (id: string) => node(id).getBoundingClientRect();
      const path = (d: string, cls: string, key: string) => {
        const p = document.createElementNS(NS, 'path');
        p.setAttribute('d', d); p.setAttribute('class', cls); p.dataset.key = key;
        svg.append(p);
      };
      for (const t of topics) {
        const a = box(t.id);
        // Tree: parent to child, down the left edge
        if (t.parent) {
          const p = box(t.parent);
          const x = p.left - g.left + 8, y1 = p.bottom - g.top, y2 = a.top + a.height / 2 - g.top;
          path(`M${x},${y1} V${y2} H${a.left - g.left}`, 'tree', `tree:${t.id}`);
        }
        for (const r of t.anchors) {
          const b = box(r);
          const x1 = a.right - g.left + 4, y1 = a.top + a.height / 2 - g.top;
          const x2 = b.left - g.left - 4, y2 = b.top + b.height / 2 - g.top;
          const m = (x1 + x2) / 2;
          path(`M${x1},${y1} C${m},${y1} ${m},${y2} ${x2},${y2}`, 'link', `${t.id}>${r}`);
        }
      }
      paint();
    };

    const paint = () => {
      const lit = new Set<string>([active]);
      const keys = new Set<string>();
      const topic = topics.find(t => t.id === active);
      if (topic) {
        const own = topic.root ? children(topic.id) : [topic.id];
        own.forEach(id => lit.add(id));
        for (const id of own) {
          const t = topics.find(x => x.id === id)!;
          t.anchors.forEach(r => { lit.add(r); keys.add(`${id}>${r}`); });
          if (topic.root) keys.add(`tree:${id}`);
        }
      } else {
        const owners = topics.filter(t => t.anchors.includes(active));
        owners.forEach(t => { lit.add(t.id); keys.add(`${t.id}>${active}`); });
      }
      fig.querySelectorAll<HTMLElement>('.gx-node').forEach(n => {
        n.classList.toggle('lit', lit.has(n.dataset.id!));
        n.setAttribute('aria-pressed', String(n.dataset.id === active));
      });
      svg.querySelectorAll<SVGPathElement>('path').forEach(p => p.classList.toggle('lit', keys.has(p.dataset.key!)));
    };

    fig.addEventListener('click', e => {
      const n = (e.target as Element).closest<HTMLElement>('.gx-node');
      if (!n) return;
      active = n.dataset.id!;
      paint();
    });
    fig.addEventListener('pointerover', e => {
      if ((e as PointerEvent).pointerType !== 'mouse') return;
      const n = (e.target as Element).closest<HTMLElement>('.gx-node');
      if (n && n.dataset.id !== active) { active = n.dataset.id!; paint(); }
    });
    new ResizeObserver(draw).observe(grid);
    document.fonts?.ready.then(draw);
  }

  document.querySelectorAll<HTMLElement>('.gx').forEach(setup);
</script>

<style>
  .gx { margin: 2em 0; padding: 20px; border: 1px solid var(--line); border-radius: 14px; background: var(--raise); }
  .gx-grid { position: relative; display: grid; grid-template-columns: auto auto; justify-content: space-between; column-gap: 48px; }
  .gx-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .gx-col { position: relative; min-width: 0; }
  .gx-col ul { list-style: none; margin: 0 0 10px; padding: 0; }
  .gx-col li { margin: 0; }
  .gx-head { margin: 0 0 4px; font: 11px "JetBrains Mono", monospace; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-3); }
  .gx-res .gx-head:not(:first-child) { margin-top: 6px; }
  .gx-res .gx-head { display: flex; align-items: center; gap: 6px; }
  .gx-icon { flex: none; fill: var(--ink-2); }
  .gx-icon.stroke { fill: none; stroke: var(--ink-2); stroke-width: 1.8; stroke-linejoin: round; }
  .gx-kind { letter-spacing: .04em; text-transform: none; color: var(--ink-3); opacity: .8; }
  .gx-kind::before { content: "· "; }
  .gx-node { display: block; margin: 3px 0; padding: 4px 9px; border: 1px solid var(--line); border-radius: 7px; background: var(--sheet); color: var(--ink-2); font: 13px/1.4 "JetBrains Mono", monospace; text-align: left; white-space: nowrap; cursor: pointer; transition: color .25s, border-color .25s, background .25s; }
  .gx-node:hover { color: var(--ink); }
  .gx-node:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .gx-topic { margin-left: 22px; }
  .gx-topic.root { margin-left: 0; margin-top: 10px; font-weight: 600; color: var(--ink); }
  .gx-topics li:first-child .gx-topic.root { margin-top: 3px; }
  .gx-branch { display: none; }
  .gx-dir { color: var(--ink-3); }
  .gx-node.lit { color: var(--ink); border-color: var(--accent); background: var(--accent-soft); }
  .gx-node[aria-pressed="true"] { box-shadow: 0 0 0 1px var(--accent); }
  .gx-lines :global(path) { fill: none; stroke: var(--ink-3); stroke-opacity: .28; stroke-width: 1.25; transition: stroke .25s, stroke-opacity .25s, stroke-width .25s; }
  .gx-lines :global(path.tree) { stroke-opacity: .5; }
  .gx-lines :global(path.lit) { stroke: var(--accent); stroke-opacity: 1; stroke-width: 2; }

  @media (max-width: 560px) {
    .gx { padding: 16px 10px; margin-left: -4px; margin-right: -4px; }
    .gx-grid { column-gap: 22px; padding-left: 20px; }
    .gx-node { font-size: 11px; padding: 3px 6px; }
    .gx-topic { margin-left: 12px; }
    .gx-dir { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .gx-node, .gx-lines :global(path) { transition: none; }
  }
</style>
